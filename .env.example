# Copy this file to .env and fill in the values. Never commit .env.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/oauth/callback
HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write crm.objects.companies.read crm.objects.deals.read crm.objects.tickets.read

# Optional. Only set if signature checks fail behind a proxy/ngrok because the
# host HubSpot calls differs from the Host header. No trailing slash, e.g.:
# PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# Optional. SQLite file that remembers which HubSpot events were already handled
# (duplicate protection, see docs/20). Default: data/webhook-events.db
# IDEMPOTENCY_DB_PATH=data/webhook-events.db

# REQUIRED for connecting a HubSpot account (OAuth tokens are stored ENCRYPTED, see
# docs/22). Must be 32 random bytes in base64. Generate one value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Paste it here in your real .env only. Never commit it, never share it, and keep a
# backup of it SEPARATE from the database: without this key the stored tokens
# cannot be read and the account must be connected again. Left empty, connecting an
# account is refused (nothing is stored in plaintext).
TOKEN_ENCRYPTION_KEY=

# Optional. SQLite file with the ENCRYPTED OAuth tokens (separate from the webhook
# event database). Default: data/oauth-tokens.db
# OAUTH_TOKEN_DB_PATH=data/oauth-tokens.db
